{
  "name": "flock",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted dashboard for running a flock of Telegram bots, each in its own process.",
  "keywords": [
    "telegram",
    "telegram-bot",
    "bot-manager",
    "dashboard",
    "self-hosted",
    "grammy",
    "bun",
    "sqlite"
  ],
  "homepage": "https://github.com/andikadevs/flock#readme",
  "bugs": {
    "url": "https://github.com/andikadevs/flock/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andikadevs/flock.git"
  },
  "license": "MIT",
  "author": "Andika Dwi Saputra <hello@andikadevs.space> (https://andikadevs.space)",
  "type": "module",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "grammy": "1.46.0",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
