DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/telegram_manager
PORT=3000

# Where a browser reaches this dashboard. Used to build the OIDC redirect URI.
APP_URL=http://localhost:3000

# Public https origin Telegram can reach. Required only for webhook-mode bots.
PUBLIC_URL=

# 32 bytes of hex. Rotating this makes every stored bot token unreadable.
TOKEN_ENCRYPTION_KEY=

# Register ${APP_URL}/auth/callback as the redirect URI with the identity provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile

# Who may administer bots. Both lists are empty by default, which admits nobody.
ADMIN_EMAILS=
ADMIN_SUBJECTS=
